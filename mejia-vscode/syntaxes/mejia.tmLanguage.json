{
    "name": "mejia",
    "scopeName": "source.mejia",
    "fileTypes": [".fc"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#function-decl" },
        { "include": "#articles" },
        { "include": "#operators" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "begin": "/\\*",
                    "end": "\\*/",
                    "name": "comment.block.mejia"
                },
                {
                    "match": "//.*$",
                    "name": "comment.line.double-slash.mejia"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.mejia",
                    "patterns": [
                        {
                            "match": "\\\\[nrt0\"\\\\]",
                            "name": "constant.character.escape.mejia"
                        },
                        {
                            "match": "\\\\x[0-9a-fA-F]{2}",
                            "name": "constant.character.escape.mejia"
                        },
                        {
                            "match": "\\{[^}]*\\}",
                            "name": "variable.parameter.mejia"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b",
                    "name": "constant.numeric.float.mejia"
                },
                {
                    "match": "\\b[0-9]+\\b",
                    "name": "constant.numeric.integer.mejia"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "\\b(si|sino|mientras|para|retornar|coincidir|como|es|está|fuese|y|o|no|en)\\b",
                    "name": "keyword.control.mejia"
                },
                {
                    "match": "\\b(función|funcion|fn|fut|futuro|rasgo|implementar|estructural|enumeración|módulo|usar|prueba|afirmar|bits)\\b",
                    "name": "keyword.declaration.mejia"
                },
                {
                    "match": "\\b(mover|copiar|prestar|esperar|lanzar|bloquear|dormir|cancelar|con_executor|región|seleccionar)\\b",
                    "name": "keyword.other.mejia"
                },
                {
                    "match": "\\b(inseguro|puro|muta|lee|verificado|estricto)\\b",
                    "name": "keyword.modifier.mejia"
                },
                {
                    "match": "\\b(verdadero|falso)\\b",
                    "name": "constant.language.boolean.mejia"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "match": "\\b(Entero8|Entero16|Entero32|Entero64|Natural8|Natural16|Natural32|Natural64|Flotante32|Flotante64|Booleano|Caracter|Palabra|Texto|Vacio)\\b",
                    "name": "storage.type.primitive.mejia"
                },
                {
                    "match": "\\b(Resultado|Vector|Diccionario|Conjunto)\\b",
                    "name": "storage.type.generic.mejia"
                },
                {
                    "match": "\\b(cualquier)\\b",
                    "name": "storage.type.any.mejia"
                }
            ]
        },
        "function-decl": {
            "patterns": [
                {
                    "match": "\\b(función|funcion|fn|fut|futuro)\\s+([a-zA-Z_áéíóúñ][a-zA-Z0-9_áéíóúñ]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.mejia" },
                        "2": { "name": "entity.name.function.mejia" }
                    }
                }
            ]
        },
        "articles": {
            "patterns": [
                {
                    "match": "\\b(el|la|un|los|las)\\b",
                    "name": "keyword.article.mejia"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "match": "->|=>|::|\\.\\.|=|\\.\\.\\.",
                    "name": "keyword.operator.directive.mejia"
                },
                {
                    "match": "\\?",
                    "name": "keyword.operator.propagation.mejia"
                },
                {
                    "match": "&|\\|\\||&&|\\|",
                    "name": "keyword.operator.logical.mejia"
                },
                {
                    "match": "==|!=|<=|>=|<|>",
                    "name": "keyword.operator.comparison.mejia"
                },
                {
                    "match": "<<|>>|>>>|~",
                    "name": "keyword.operator.bitwise.mejia"
                },
                {
                    "match": "[+\\-*/%]",
                    "name": "keyword.operator.arithmetic.mejia"
                },
                {
                    "match": "&(?![&|])",
                    "name": "keyword.operator.reference.mejia"
                },
                {
                    "match": "\\*",
                    "name": "keyword.operator.dereference.mejia"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "match": "\\b([A-ZÁÉÍÓÚÑ][a-zA-Z0-9_áéíóúñ]*)\\b",
                    "name": "support.class.mejia"
                },
                {
                    "match": "\\b([a-z_áéíóúñ][a-zA-Z0-9_áéíóúñ]*)\\b",
                    "name": "variable.other.mejia"
                }
            ]
        }
    }
}

